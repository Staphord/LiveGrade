# Copy to .env. Placeholders: set the real addresses once the domain is chosen.
SECRET_KEY=change-me-to-a-long-random-value-of-32-plus-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LIVEGRADE_BASE_URL=http://localhost:8001
# Optional public origin for share/QR links. Set this to a stable hostname or
# the computer's current Wi-Fi address when other devices must open local links.
# This is separate from LIVEGRADE_BASE_URL, used for service sign-in.
# LIVEGRADE_PUBLIC_BASE_URL=http://192.168.1.50:8001
DEVPERF_URL=http://localhost:8000
# From `python manage.py register_livegrade_client --base-url $LIVEGRADE_BASE_URL` in DevPerf
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
# SMTP for Panel examiner invitations. Store credentials here only in an
# untracked local .env, or in the deployment's secret manager.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=LiveGrade <noreply@example.com>
# Optional: production database (defaults to local SQLite)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=livegrade
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=
# Live updates and turn timers. Database 1 so DevPerf's (0) is never shared.
# REDIS_URL=redis://127.0.0.1:6379/1
# Only for the one-off copy of old sessions out of DevPerf (import_from_devperf):
# DEVPERF_DB_NAME=devperf
# DEVPERF_DB_USER=
# DEVPERF_DB_PASSWORD=
# DEVPERF_DB_HOST=localhost
# DEVPERF_DB_PORT=5432

# Services open to the public, comma separated. Default: classroom,polls.
# LIVEGRADE_LIVE_SERVICES=classroom,polls
# Coming-soon notification attempts per verified client address; both must be positive.
# LIVEGRADE_INTEREST_RATE_LIMIT=5
# LIVEGRADE_INTEREST_RATE_WINDOW=600
# Maximum requests per active Panel examiner link and rolling cache window.
# PANEL_EXAMINER_RATE_LIMIT=120
# PANEL_EXAMINER_RATE_WINDOW=60
# Maximum unknown public bearer-link requests per server-observed remote address.
# Cache keys are HMACs; cache failure blocks unknown-link requests.
# PUBLIC_BEARER_UNKNOWN_RATE_LIMIT=300
# PUBLIC_BEARER_UNKNOWN_RATE_WINDOW=60
# Showcase visitor traffic budget per source/event (defaults allow a 600-person
# crowd to load and submit ratings during a one-minute burst).
# SHOWCASE_PUBLIC_RATE_LIMIT=2000
# SHOWCASE_PUBLIC_RATE_WINDOW=60

# Show our own 404/500 pages even with DEBUG on (default). False = Django technical pages for debugging.
# FRIENDLY_ERROR_PAGES=True

# Content-Security-Policy: enforced when DEBUG is off, report-only while developing. False forces report-only.
# CSP_ENFORCE=True
# Production HSTS. Turn these on only when every subdomain serves HTTPS.
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
